@model TodoItem

@{
    var isOverdue = Model.DueDate.HasValue && Model.DueDate.Value.ToUniversalTime() < DateTime.UtcNow && !Model.IsCompleted;
    var dueBadgeClass = isOverdue ? "bg-danger text-white" : "bg-warning text-dark";
}

<li class="list-group-item d-flex align-items-start gap-2 py-3" data-id="@Model.Id">
    <div class="pt-1">
        <input type="checkbox" class="form-check-input toggle-complete"
               @(Model.IsCompleted ? "checked" : "") />
    </div>
    <div class="flex-grow-1 min-width-0">
        <div>
            <span class="todo-title @(Model.IsCompleted ? "todo-completed" : "")">@Model.Title</span>
            @if (Model.DueDate.HasValue)
            {
                <span class="badge @dueBadgeClass ms-2">
                    Due: @Model.DueDate.Value.ToLocalTime().ToString("MM/dd/yyyy")
                </span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div><small class="text-muted">@Model.Description</small></div>
        }
    </div>
    <div class="d-flex gap-1 flex-shrink-0">
        <button class="btn btn-sm btn-outline-secondary btn-edit" title="Edit">
            <i class="bi bi-pencil"></i>
        </button>
        <button class="btn btn-sm btn-outline-danger btn-delete" title="Delete">
            <i class="bi bi-trash"></i>
        </button>
    </div>
</li>
